%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#070707",
    "primaryColor": "#17120B",
    "primaryTextColor": "#F7F3EA",
    "primaryBorderColor": "#C9A45C",
    "lineColor": "#AFA89B",
    "secondaryColor": "#101820",
    "tertiaryColor": "#171717",
    "clusterBkg": "#0D0D0D",
    "clusterBorder": "#4B4438",
    "edgeLabelBackground": "#070707",
    "fontFamily": "Microsoft YaHei, Noto Sans CJK SC, Arial, sans-serif",
    "fontSize": "18px"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "nodeSpacing": 36,
    "rankSpacing": 52,
    "padding": 18,
    "useMaxWidth": false
  }
}}%%

flowchart TB
    USER["用户 / CMD 多轮对话"]
    TIMER["每日定时任务"]

    subgraph SESSION["会话与上下文"]
        direction LR
        SM["Session Manager<br/>对话历史 · 当前目标 · 用户偏好"]
        CB["Context Builder<br/>工作记忆 + RAG + 最新观察"]
        WM[("Working Memory<br/>计划 · 子目标 · 证据 · 未决问题")]
        SM --> CB
        WM <--> CB
    end

    USER --> SM
    TIMER --> SM

    subgraph RUNTIME["智能 Agent Runtime · Plan → Execute → Observe → Check → Replan"]
        direction LR
        PLAN["Planner<br/>拆解目标并生成动态任务图"]
        DAG["Task Graph<br/>可串行 · 并行 · 循环 · 依赖"]
        EXEC["Executor<br/>选择 Skill 并执行下一步"]
        OBS["Observation Bus<br/>统一结构化工具结果"]
        CHECK["Result Checker<br/>状态 · 相关性 · 完整性 · 可信度"]
        STOP{"Stop Controller<br/>目标是否真正完成？"}

        PLAN --> DAG --> EXEC --> OBS --> CHECK --> STOP
        STOP -->|"证据不足 / 仍有信息增益"| PLAN
    end

    CB --> PLAN
    CHECK -->|"更新状态"| WM

    subgraph SKILLS["可组合 Skill Registry"]
        direction LR
        TALK["Dialogue Skill<br/>解释 · 追问 · 组织回答"]
        SEARCH["Forum Search Skill<br/>明确主题必须走原生搜索"]
        BROWSE["Forum Browse Skill<br/>明确刷帖 / 每日采集 / 泛主题栏目发现"]
        DETAIL["Post Detail Skill<br/>正文 · 图片 · 评论"]
        MR["Memory Retrieve Skill<br/>历史信息与语义召回"]
        MW["Memory Write Skill<br/>提炼 · 去重 · 保存 · 回读验证"]
        FILE["Local File Skill<br/>受限路径读写"]
    end

    EXEC --> TALK
    EXEC --> SEARCH
    EXEC --> BROWSE
    EXEC --> DETAIL
    EXEC --> MR
    EXEC --> MW
    EXEC --> FILE

    TALK --> OBS
    SEARCH --> OBS
    BROWSE --> OBS
    DETAIL --> OBS
    MR --> OBS
    MW --> OBS
    FILE --> OBS

    subgraph SEARCHPIPE["原生搜索链路 · 禁止退化为普通信息流"]
        direction LR
        KW["关键词扩展<br/>国创赛 · 国创 · 大创 · 创新大赛"]
        BOX["逐词点击并填写<br/>微北洋原生搜索框"]
        SR["解析搜索结果页<br/>允许滚动结果页"]
        MERGE["合并 · 去重 · 排序<br/>保留搜索词与帖子来源"]
        KW --> BOX --> SR --> MERGE
    end

    SEARCH --> KW
    MERGE --> SEARCH

    subgraph BROWSEPIPE["栏目探索链路"]
        direction LR
        MAP["主题映射栏目<br/>食堂→美食 · 课程→学习"]
        FEED["有限浏览信息流"]
        GAIN["评估新颖度与信息增益"]
        MAP --> FEED --> GAIN
    end

    BROWSE --> MAP
    GAIN --> BROWSE

    subgraph MEMORY["长期记忆与本地 RAG"]
        direction LR
        EMB["Embedding Provider<br/>远程 /embeddings 或本地中文模型"]
        VDB[("Vector DB<br/>Qdrant Local")]
        SQL[("SQLite<br/>来源 · 时间 · 标签 · 过期策略")]
        ARCH[("Markdown / JSON<br/>帖子原文与审计记录")]
        RAG["Hybrid Retriever<br/>向量 + 关键词 + 元数据过滤"]

        EMB --> VDB
        VDB --> RAG
        SQL --> RAG
        ARCH --> RAG
    end

    MR --> RAG
    RAG --> MR
    MW --> EMB
    MW --> SQL
    MW --> ARCH

    subgraph PLATFORM["外部运行环境"]
        direction LR
        LLM["LLM APIs<br/>Responses · Embeddings"]
        ADB["ADB / BlueStacks"]
        APP["天外天 App / 微北洋"]
        FS["受限本地文件系统"]
        ADB --> APP
    end

    PLAN <--> LLM
    CHECK <--> LLM
    SEARCH --> ADB
    BROWSE --> ADB
    DETAIL --> ADB
    FILE --> FS

    STOP -->|"需要补充条件"| ASK["向用户追问"]
    ASK --> USER
    STOP -->|"目标完成"| FINAL["Response Synthesizer<br/>基于证据生成回答并标注来源"]
    FINAL --> CONSOLIDATE["Memory Consolidator<br/>只保存长期有价值的信息"]
    CONSOLIDATE --> MW
    FINAL --> USER

    classDef entry fill:#20170A,stroke:#E2B95F,color:#FFF8E8,stroke-width:2px;
    classDef core fill:#17120B,stroke:#C9A45C,color:#F7F3EA,stroke-width:2px;
    classDef skill fill:#101820,stroke:#6E8CA6,color:#EEF6FC,stroke-width:1.5px;
    classDef store fill:#151515,stroke:#8F8575,color:#F1ECE3,stroke-width:1.5px;
    classDef gate fill:#2A1B0C,stroke:#E2B95F,color:#FFF8E8,stroke-width:2px;
    classDef output fill:#182219,stroke:#74A47A,color:#EFF8F0,stroke-width:2px;

    class USER,TIMER entry;
    class SM,CB,PLAN,DAG,EXEC,OBS,CHECK core;
    class STOP gate;
    class TALK,SEARCH,BROWSE,DETAIL,MR,MW,FILE,KW,BOX,SR,MERGE,MAP,FEED,GAIN,RAG skill;
    class WM,VDB,SQL,ARCH,FS store;
    class ASK,FINAL,CONSOLIDATE output;
